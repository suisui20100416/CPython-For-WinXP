@echo off
REM Build OpenSSL 3.5.9 (shared, no-asm) with llvm-mingw for XP, producing
REM   externals\openssl-3.5.9-src\libcrypto-3.dll / libssl-3.dll  (runtime)
REM   externals\openssl-3.5.9-src\libcrypto.lib / libssl.lib      (imports)
REM The .lib files are copies of llvm-mingw's *.dll.a import libraries;
REM MSVC links them fine (measured, Python/STAGE-C-结论.md 8.x).
REM
REM Prerequisites (override via environment):
REM   PERL        a perl with ExtUtils::MakeMaker, e.g. the perl bundled
REM               with Git for Windows (the default `perl` on PATH from
REM               MSYS lacks MakeMaker)
REM   LLVMMINGW   llvm-mingw root (provides mingw32-make and the toolchain)
setlocal

if not defined PERL set "PERL=perl"
if not defined LLVMMINGW set "LLVMMINGW=C:\Program Files (x86)\llvm-mingw"
set "PATH=%LLVMMINGW%\bin;%PATH%"
REM The Makefile generated by Configure invokes perl internally, so
REM PERL must be an absolute path and its directory goes on PATH.
for %%I in ("%PERL%") do set "PATH=%%~dpI;%PATH%"

REM Build-assist interpreter; PYEXE overrides it (see README.md).
if not defined PYEXE set "PYEXE=py"
set "OSSLSRC=%~dp0externals\openssl-3.5.9-src"
if not exist "%~dp0build\out\obj" mkdir "%~dp0build\out\obj"
if not exist "%OSSLSRC%\Configure" (echo [openssl] %OSSLSRC% not found & exit /b 1)

REM The checked-in Makefile/configdata.pm cannot be regenerated on this
REM host: git checkouts stamp every file at extraction time in arbitrary
REM order, which wakes the perl regeneration recipes (configdata.pm
REM itself, the .in-generated headers, depend) - and every one of them,
REM including `perl Configure`, needs modules the trimmed Git-Bash perl
REM lacks (Pod::Usage, ExtUtils::MakeMaker).  Instead, on the first
REM build in a tree, re-stamp the checked-in Configure outputs in
REM dependency order (configdata.pm, then the .in-generated headers;
REM the empty `depend` file below completes the chain) so make goes
REM straight to compiling.  Do NOT edit the openssl sources in place:
REM touching a .in file would re-wake the perl path.
REM The stamp below uses `type nul >>`: it appends nothing and refreshes
REM mtime.  Do NOT use `copy /b "file"+,,` here - with a quoted path cmd
REM parses that as a directory wildcard and fails.  And keep parentheses
REM out of REM lines inside parenthesized blocks - a stray ) closes the
REM block early and silently skips the rest of it.
if not exist "%OSSLSRC%\Makefile" (
  echo [openssl] step 1/2: Configure mingw shared no-asm ...
  cd /d "%OSSLSRC%"
  "%PERL%" Configure mingw shared no-asm 1>"%~dp0build\out\obj\openssl_configure.log" 2>&1
  if errorlevel 1 (echo [openssl] Configure FAILED & type "%~dp0build\out\obj\openssl_configure.log" & exit /b 1)
) else (
  echo [openssl] step 1/2: Makefile present, skipping Configure
)

REM The vendored Makefile already carries the XP additions
REM (-D_WIN32_WINNT=0x0501 on CPPFLAGS/CFLAGS and the subsystem LDFLAGS,
REM with the Apache-2.0 4(b) notice above them) - no runtime patching
REM needed anymore (18-test; see STAGE-C 8.34 for what they look like
REM should openssl ever be reconfigured).

REM The generated Makefile has `depend: Makefile` with no output file, so
REM GNU make re-runs the depend recipe on EVERY invocation; it calls
REM util/add-depends.pl, which requires perl's Pod::Usage - absent from
REM the trimmed perl shipped with Git for Windows. The .d dependency data
REM only serves incremental rebuilds, and this source tree is built
REM read-only: satisfy the target with an empty `depend` file instead.
REM Created BEFORE the stamp below so the stamp gives it a future mtime
REM too - a now-time depend file is older than the stamped Makefile and
REM make would re-run the recipe.
if exist "%OSSLSRC%\depend" del /q "%OSSLSRC%\depend"
type nul > "%OSSLSRC%\depend"

REM Stamp AFTER the patch and AFTER creating `depend`: the patch rewrites
REM the Makefile and the Makefile is itself a make target (its recipe is
REM the perl that cannot run here), so both must end up in the stamped
REM future together with every other generated file.
if not exist "%OSSLSRC%\.xp_build_ok" (
  echo [openssl] fresh tree: stamping generated files into the future
  "%PYEXE%" "%~dp0Tools\xp\stamp_openssl_xp.py" "%OSSLSRC%"
  if errorlevel 1 (echo [openssl] stamp FAILED & exit /b 1)
)

echo [openssl] step 2/2: mingw32-make ...
cd /d "%OSSLSRC%"
mingw32-make -j%NUMBER_OF_PROCESSORS% 1>"%~dp0build\out\obj\openssl_build.log" 2>&1
if errorlevel 1 (echo [openssl] make FAILED & type "%~dp0build\out\obj\openssl_build.log" & exit /b 1)
REM Build stamp: proves this tree's Configure outputs belong HERE with a
REM consistent timestamp chain (see the comment above step 1/2).
type nul > "%OSSLSRC%\.xp_build_ok"

if not exist "%OSSLSRC%\libcrypto.lib" copy /y "%OSSLSRC%\libcrypto.dll.a" "%OSSLSRC%\libcrypto.lib" >nul
if not exist "%OSSLSRC%\libssl.lib" copy /y "%OSSLSRC%\libssl.dll.a" "%OSSLSRC%\libssl.lib" >nul
echo [openssl] done: libcrypto-3.dll / libssl-3.dll / libcrypto.lib / libssl.lib
endlocal
